  m_Script: {fileID: 11500000, guid: cf49ea3019c1590489a6f8ddf8508a2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  words:
  - Ever since I was young, I've always been able to understand people more than
    others. ||
  - "Trying to see things from others\u2019 perspectives was second nature to me. 
    ||"
  - it grew even stronger after i studied psychology in college ||
  - "It's as if\u2026 their mind takes shape and plays like a movie.  ||"
  - "It\u2019s not always fun. But as a psychologist, it\u2019s one handy skill to
    have. ||"
  dialogueUI: {fileID: 884509914}
  typingSpeed: 0.03
  pauseDuration: 0.3
  durationWaitNewBuble: 6
  canvasGroup: {fileID: 2121447543}
  audioSourceMusic: {fileID: 793084062}
  audioSourceDialogue: {fileID: 508155437}
  LoadNextSceneName: Scene_02
  isLoadNextScene: 1
